# All optional. With none of these set, Crawlspace runs in deterministic mode:
# the full audit, scoring, findings, block analysis, file generation and export
# all work. Only /api/rewrite is disabled, and the UI explains why.

# Enables the rewrite layer with Claude
ANTHROPIC_API_KEY=

# Or with GPT
OPENAI_API_KEY=

# anthropic | openai — which to prefer when both are set
CRAWLSPACE_DEFAULT_PROVIDER=anthropic
