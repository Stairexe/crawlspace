# All optional. With none of these set, Crawlspace runs in deterministic mode:
# the full audit, scoring, findings, block analysis, file generation and export
# all work. Only /api/rewrite is disabled, and the UI explains why.

# Enables the rewrite layer with Claude
ANTHROPIC_API_KEY=

# Or with GPT
OPENAI_API_KEY=

# anthropic | openai — which to prefer when both are set
CRAWLSPACE_DEFAULT_PROVIDER=anthropic

# ── Accounts (optional) ─────────────────────────────────────────────────────
# Accounts add saved history and share links. Audits never need them.
# Signs session cookies. 32+ random characters. Required in production for accounts;
# development uses a built-in local secret.
AUTH_SECRET=
# Vercel Blob (private store). Set automatically when a Blob store is connected to the
# project. Without it, production switches accounts off; development uses ./.data/.
BLOB_READ_WRITE_TOKEN=
# Self-hosting without Blob: CRAWLSPACE_STORAGE=fs stores JSON under CRAWLSPACE_DATA_DIR.
# CRAWLSPACE_STORAGE=fs
# CRAWLSPACE_DATA_DIR=/var/lib/crawlspace
